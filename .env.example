# Copy to .env and fill in. .env is gitignored — keys never enter the repo.
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_MODEL=muse-spark-1.3

# External, pre-existing Ansai services (declared; not part of this build)
ATTEST_API_URL=https://attestation.ansaitechnologies.co.ke

# Google sign-in (the webapp's front door) — the shared "Ansai Web" OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://hazina.ansaitechnologies.co.ke/api/auth?provider=google&step=callback
